# ============================================
# ProVisa Environment Variables
# ============================================

# --- Backend (backend/.env) ---
# Your MongoDB Atlas connection string
MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net/provisa

# Secret key for JWT signing (generate a strong random string)
JWT_SECRET=your-super-secret-jwt-key-change-this

# Frontend URL (for CORS)
CLIENT_URL=http://localhost:5173

# Port (Render sets this automatically)
PORT=4000

# --- Frontend (root .env) ---
# API base URL for production (set on Render dashboard)
# Locally this falls back to /api via Vite proxy
VITE_API_BASE_URL=https://your-backend-service.onrender.com/api
