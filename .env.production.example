# Production env example for BOTH backend and frontend.
# Copy values from your deployment provider (Render/Railway/etc.)
# and set them in:
#  - backend/.env (server runtime)
#  - frontend/.env.production.local (Vite build-time)

# -----------------------------
# Backend
# -----------------------------
PORT=4000
MONGODB_URI=mongodb://127.0.0.1:27017/provisa

# The public URL where your frontend is served.
# Used for CORS allowlist.
CLIENT_URL=https://your-frontend-domain.com

# Used by backend auth routes (JWT).
JWT_SECRET=change-me

# Optional: Cloud storage (only if you use it elsewhere)
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=

# -----------------------------
# Frontend (Vite build-time)
# -----------------------------
# Full backend API origin (without the /api prefix).
# Example: https://your-backend-domain.com
VITE_API_BASE_URL=https://your-backend-domain.com/api

# If your frontend and backend are on the same host, you can also set:
# VITE_API_BASE_URL=/api

