# Vite frontend production env example
# Note: Vite only exposes variables prefixed with VITE_
#
# If your backend is deployed on another host:
# VITE_API_BASE_URL=https://your-backend-domain.com/api
#
# If serving frontend and backend behind the same origin/reverse-proxy:
# VITE_API_BASE_URL=/api

VITE_API_BASE_URL=/api

